{
  "name": "paola",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Portal Paola Biker — Vue + Vuetify, arquitectura modular",
  "scripts": {
    "dev": "concurrently -k -n front,back -c cyan,magenta \"vite\" \"node server/index.mjs\"",
    "dev:front": "vite",
    "dev:back": "node server/index.mjs",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "start": "node server/index.mjs"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.8",
    "concurrently": "^10.0.5",
    "typescript": "~6.0.2",
    "vite": "^8.2.0",
    "vite-plugin-vuetify": "^2.1.3",
    "vue-tsc": "^3.3.10"
  },
  "dependencies": {
    "@fontsource/montserrat": "^5.3.0",
    "@fontsource/oswald": "^5.3.0",
    "@formkit/auto-animate": "^0.10.0",
    "@mdi/font": "^7.4.47",
    "dotenv": "^17.4.2",
    "gsap": "^3.15.0",
    "mysql2": "^3.23.3",
    "vue": "^3.5.41",
    "vue-router": "^5.2.0",
    "vuetify": "^4.1.9"
  }
}
